# SCM — variables de entorno
#
# Solo NOMBRES y qué hace cada una. NUNCA valores reales: este archivo se
# commitea. Los valores viven en el .env local (gitignored) y en Railway.
#
# `npm run lint:env` falla si el código lee una variable que no está acá.
# Auditoría 2026-09-03 (CONF-05): antes había 13 variables leídas y sin
# documentar, así que cuando algo no andaba en producción el motivo no estaba
# escrito en ningún lado.

# ── Obligatorias en producción ───────────────────────────────────────────
# NODE_ENV=production. De ella cuelgan SIETE protecciones: cookie Secure,
# webhooks de Telnyx y Retell fail-closed, el tool /book, el no-leak de
# err.message, el fail-fast de JWT_SECRET y el CORS de Socket.IO.
# nixpacks.toml NO la fuerza a propósito (commit 756c548): se setea como
# variable en Railway. `/api/admin/health` reporta `prodGuardsActive`.
NODE_ENV=
# Secret para firmar los JWT del módulo WA / app desktop. Mínimo 16 chars.
# En production, si falta o es corta, el server hace exit(1) al arrancar.
JWT_SECRET=
# Credenciales del admin que se siembra al primer arranque.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── Correo ───────────────────────────────────────────────────────────────
# Canal de salida del correo AL PROSPECTO: 'resend' (default) o 'gmail'.
# El milestone v5.0 se construyó sobre Gmail y se REVIRTIÓ el 31/08
# (commit 0f4d5ce): Railway bloquea los puertos SMTP (25/465/587) fuera del
# plan Pro, así que el envío por Gmail se colgaba. Gmail quedó detrás de esta
# variable para correr local o el día que se pase a Pro.
MAIL_TRANSPORT=
# API key de Resend. Canal por default del correo al prospecto, y además las
# invitaciones al equipo y el reporte semanal (esos SIEMPRE van por Resend).
RESEND_API_KEY=
# From de los correos al prospecto (hold de calendario y correo del puente).
# OBLIGATORIA con MAIL_TRANSPORT=resend: tiene que ser del dominio verificado
# en Resend (ej: `Ignacio Ana <ignacio@vincca.co>`). Sin ella no se intenta el
# envío y send-material cae al 409-mailto — Resend rechaza su dominio
# compartido (onboarding@resend.dev) para escribirle a un tercero.
PLACEHOLDER_FROM_EMAIL=
# Reply-To de los correos al prospecto: la casilla de Workspace donde tienen
# que caer las respuestas. Si no está, la clave se OMITE del payload (Resend
# rechaza un reply_to vacío).
REPLY_TO_EMAIL=
# From de las invitaciones al equipo y del reporte semanal (no del prospecto).
INVITE_FROM_EMAIL=
# Destinatarios del reporte semanal, CSV. Sin ella el reporte no tiene a quién
# ir. REPORT_DM_FALLBACK: destinatario de respaldo del envío directo.
# REPORT_SEND_NOW_WAIT_MS: espera del "mandar ahora" manual.
REPORT_EMAILS=
REPORT_DM_FALLBACK=
REPORT_SEND_NOW_WAIT_MS=
# Gmail Workspace — solo se usan con MAIL_TRANSPORT=gmail.
# GMAIL_APP_PASSWORD es la contraseña de aplicación de 16 chars (sin espacios).
# GMAIL_FROM_NAME es el nombre visible; sin ella el From sale a secas.
# GMAIL_SMTP_PORT (465 default) y GMAIL_SMTP_FAMILY (4 = forzar IPv4: en redes
# sin ruta IPv6 saliente, Node resuelve a IPv6 y falla antes de probar IPv4).
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=
GMAIL_SMTP_PORT=
GMAIL_SMTP_FAMILY=

# ── IA ───────────────────────────────────────────────────────────────────
# Cadena real de fallback: OPENAI primero, después MERCURY, después QWEN.
# OJO: OPENAI_API_KEY no habilita "solo Whisper" — si está seteada, TODA la IA
# del sistema pasa a OpenAI (y a su factura), no solo la transcripción.
OPENAI_API_KEY=
OPENAI_MODEL=
MERCURY_API_KEY=
QWEN_API_KEY=
OPENROUTER_MODEL=
# Usar Qwen para las conversaciones de warmeo del módulo WA (parkeado).
WARMING_USE_QWEN=

# ── Telefonía (Telnyx) ───────────────────────────────────────────────────
# Estos cinco, si están seteados, GANAN sobre data/telnyx_config.json y el
# panel admin bloquea su edición (PUT devuelve 409). Así los secrets no tocan
# el volumen de Railway ni los backups. Se leen por indexación dinámica
# (TELNYX_ENV_FIELDS), no como process.env.NOMBRE.
TELNYX_API_KEY=
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=
TELNYX_SIP_CONNECTION_ID=
TELNYX_SIGNATURE_PUBLIC_KEY=

# ── Agente de voz (Retell) ───────────────────────────────────────────────
# Mismo criterio que Telnyx: env gana sobre retell_config.json y el PUT
# devuelve 409. RETELL_WEBHOOK_SECRET cae a RETELL_API_KEY si está vacía
# (Retell firma el webhook con el mismo API key); RETELL_TOOL_SECRET NO tiene
# fallback a propósito — protege nuestro propio endpoint /book.
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=
RETELL_TOOL_SECRET=

# ── Scraping y enriquecimiento ───────────────────────────────────────────
# SerpAPI (Google Maps).
API_KEY=
# Apify (Instagram Scraper).
APIFY_TOKEN=
# Meta Ad Library: habilita la detección de "ya pauta" en España.
META_AD_LIBRARY_TOKEN=

# ── Infra ────────────────────────────────────────────────────────────────
# Puerto del server (Railway lo inyecta solo).
PORT=
# Dónde viven los JSON. En Railway es /data (el volumen). Vacío = ./data.
DATA_DIR=
# Zona horaria de negocio para TODOS los cortes de "hoy" de las métricas.
# Railway corre en UTC: sin esto, la medianoche cae a las 21:00 de AR/UY.
BUSINESS_TZ=
# Orígenes permitidos del Socket.IO del módulo WA (CSV). Solo aplica con
# NODE_ENV=production; vacía = same-origin. Tiene que incluir el origen de la
# app o el panel no conecta.
WA_CORS_ORIGINS=

# ── Solo para scripts de scripts/ (no las lee el server) ─────────────────
# URL base contra la que corren los one-shot y los seeds.
RAILWAY_URL=
# scripts/brief-espana.mjs
BRIEF_COUNTRY=
REVIEWS_ROUNDS=
WEB_ROUNDS=
# scripts/smoke-wa.mjs
SMOKE_URL=
SMOKE_EMAIL=
SMOKE_PASSWORD=
